# Caponera App - Configuración de Entorno
# ATENCIÓN: NUNCA subir valores reales o secretos al repositorio git.

# Llave maestra para acceso al panel /admin (exigida por CA-1)
CAPONERA_ADMIN_KEY=cambiar_por_llave_secreta_en_produccion

# Modo semilla demo (1 = crea conductores iniciales de prueba; 0 = producción vacía)
CAPONERA_SEED_DEMO=0

# Tiempo de vida máximo de un viaje en búsqueda antes de marcarlo expirado (en segundos)
CAPONERA_VIAJE_TTL_SEC=900

# Ciudad operativa por defecto y rangos tarifarios (C$)
CAPONERA_CIUDAD=Masaya
CAPONERA_TARIFA_MIN=15.0
CAPONERA_TARIFA_MAX=250.0

# Binding de red (127.0.0.1 por defecto para aislamiento loopback)
HOST=127.0.0.1
PORT=5054
